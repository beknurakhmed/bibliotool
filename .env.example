# OpenAlex (https://openalex.org/settings/api) — бесплатный ключ, $1/день
OPENALEX_API_KEY=
OPENALEX_MAILTO=you@example.com

# LLM для описания кластеров: ollama (локально, бесплатно) или anthropic
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Модель эмбеддингов (sentence-transformers). Мультиязычная, ~470 МБ
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
